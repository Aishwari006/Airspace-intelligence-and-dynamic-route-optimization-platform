# Sky Force Environment Configuration Example
# Copy this file to `.env` and fill in optional credentials as needed.
# NEVER commit your actual `.env` file to version control.

# Application
SKYFORCE_APP_NAME="Sky Force"
SKYFORCE_ENVIRONMENT="development"
SKYFORCE_LOG_LEVEL="INFO"

# Database (defaults to local SQLite; switch to PostgreSQL for production-style runs)
SKYFORCE_DATABASE_URL="sqlite:///./data/skyforce.db"
# SKYFORCE_DATABASE_URL="postgresql+psycopg://skyforce:changeme@localhost:5432/skyforce"

# OpenSky Network API (OAuth2 Client Credentials - optional; falls back to synthetic demo dataset)
SKYFORCE_OPENSKY_BASE_URL="https://opensky-network.org/api"
SKYFORCE_OPENSKY_TOKEN_URL="https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token"
SKYFORCE_OPENSKY_CLIENT_ID=""
SKYFORCE_OPENSKY_CLIENT_SECRET=""
SKYFORCE_OPENSKY_MIN_INTERVAL_S=30.0

# Weather & Reference Data APIs (public non-commercial endpoints)
SKYFORCE_OPEN_METEO_ARCHIVE_URL="https://archive-api.open-meteo.com/v1/archive"
SKYFORCE_AVIATION_WEATHER_BASE_URL="https://aviationweather.gov/api/data"
SKYFORCE_OURAIRPORTS_CSV_URL="https://davidmegginson.github.io/ourairports-data/airports.csv"

# HTTP Client Resilience
SKYFORCE_HTTP_TIMEOUT_S=15.0
SKYFORCE_HTTP_MAX_RETRIES=3

# Google Gemini API Configuration (replacing Ollama for Natural Language Explainability)
# Place your Google Gemini API key obtained from https://aistudio.google.com/ below:
GEMINI_API_KEY=""
SKYFORCE_GEMINI_API_KEY=""
SKYFORCE_GEMINI_MODEL="gemini-1.5-flash"
SKYFORCE_GEMINI_TIMEOUT_S=6.0
